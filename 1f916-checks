# witness

def cmd_witness(ctx, args):
    body = ctx.fetch(args.url)
    ends_nl = body.endswith(b"\n")
    raw_lines = body.split(b"\n")
    if ends_nl:
        raw_lines = raw_lines[:-1]
    if raw_lines == [b""]:
        raw_lines = []
    complete = body.count(b"\n")
    objs = []
    for i, raw in enumerate(raw_lines):
        if not raw.strip():
            objs.append(None)
            continue
        try:
            objs.append(json.loads(raw.decode("utf-8")))
        except ValueError:
            raise CouldNotRun("witness line %d is not JSON" % (i + 1))
    parsed = [o for o in objs if isinstance(o, dict)]
    if not parsed:
        raise CouldNotRun("witness file has no JSON object lines")
    last = parsed[-1]
    newest = parse_iso(last.get("at"))
    if newest is None:
        raise CouldNotRun("the last witness line has no parseable `at`")
    exact = (ctx.now - newest).total_seconds() / 60.0
    age = round(exact, 1)
    # Bucketed on the exact age, not the rounded one: 120.04 minutes is LATE.
    if exact <= 120:
        fresh = "FRESH"
    elif exact <= 180:
        fresh = "LATE"
    else:
        fresh = "STALE"

    def refused(o):
        return isinstance(o, dict) and str(o.get("status", "")).startswith("refused")

    full = sha256_hex(body)
    all_prefix = line_prefix(body, complete)
    out = {
        "lines": len(raw_lines),
        "bytes": len(body),
        "ends_with_newline": ends_nl,
        "newest_at": last.get("at"),
        "age_minutes": age,
        "freshness": fresh,
        "last_status": last.get("status"),
        "refused_lines": sum(1 for o in objs if refused(o)),
        "refused_new": None,
        "refused_new_scope": None,
        "refused_examples": None,
        "full_sha256": full,
        "prior_n": None,
        "prior_prefix_hash": None,
        "prefix_sha256_now": None,
        "prefix_match": None,
        "truncated": None,
        "appended": None,
        "baseline_missing": [],
        "new_pair": {"n": complete,
                     "prefix_hash": full if ends_nl else sha256_hex(all_prefix)},
    }
    def count_refused(start, scope):
        new = [o for o in objs[start:] if refused(o)]
        out["refused_new"] = len(new)
        out["refused_new_scope"] = scope
        out["refused_examples"] = new[:3]

    # With no usable prior n, "new" is counted over the whole file and the
    # scope says so: a superset, so 0 still means no refused line was missed.
    prior = ctx.read_row(args.prior)
    if prior is None:
        out["baseline_missing"] = ["prior"]
        count_refused(0, "whole_file")
        return out
    n = prior.get("n")
    ph = prior.get("prefix_hash")
    if isinstance(n, bool) or not isinstance(n, int) or n < 0:
        out["baseline_missing"].append("n")
        n = None
    if ph is None:
        out["baseline_missing"].append("prefix_hash")
    out["prior_n"] = n
    out["prior_prefix_hash"] = ph
    if n is None:
        count_refused(0, "whole_file")
    else:
        count_refused(n, "since_prior_n")
        out["appended"] = len(raw_lines) - n
        prefix = line_prefix(body, n)
        if prefix is None:
            out["truncated"] = True
            out["prefix_match"] = False if ph is not None else None
        else:
            out["truncated"] = False
            out["prefix_sha256_now"] = sha256_hex(prefix)
            if ph is not None:
                out["prefix_match"] = out["prefix_sha256_now"] == ph
    return out


