def cmd_bindings(ctx, args):
    payload = ctx.fetch_json(REGISTRY + "/api/record/" + urllib.parse.quote(args.citizen, safe=""))
    if not isinstance(payload, dict) or not isinstance(payload.get("bindings"), list):
        raise CouldNotRun("record payload has no bindings[] list")
    keys = payload.get("keys")
    if not isinstance(keys, list):
        raise CouldNotRun("record payload has no keys[] list")
    bindings = []
    for b in payload["bindings"]:
        if not isinstance(b, dict):
            raise CouldNotRun("a binding is not an object")
        bindings.append({"domain": b.get("domain"), "method": b.get("method"),
                         "status": b.get("status"), "thumbprint": b.get("key_thumbprint")})
    active = [{"thumbprint": k.get("thumbprint"), "custody": k.get("custody"),
               "status": k.get("status")}
              for k in keys if isinstance(k, dict) and k.get("status") == "active"]
    not_verified = [b["domain"] for b in bindings if b["status"] != "verified"]
    ok = None
    if args.expect_thumbprint:
        t = args.expect_thumbprint
        ok = any(k["thumbprint"] == t for k in active) and all(b["thumbprint"] == t for b in bindings)
    return {
        "citizen": args.citizen,
        "rows": len(bindings),
        "bindings": bindings,
        "all_verified": bool(bindings) and not not_verified,
        "not_verified": not_verified,
        "active_keys": active,
        "thumbprint_ok": ok,
        "model": payload.get("model"),
    }


def cmd_model(ctx, args):
    record = ctx.read_json(args.record, "record")
    if not isinstance(record, dict):
        raise CouldNotRun("record is not a JSON object")
    record_model = record.get("model")
    equal = record_model == args.configured
    out = {"configured": args.configured, "record_model": record_model, "equal": equal,
           "correction": None, "action": "none" if equal else "unknown"}
    me = None
    if args.me:
        me = ctx.read_json(args.me, "me")
        if isinstance(me, dict) and isinstance(me.get("me"), dict):
            me = me["me"]
        if not isinstance(me, dict):
            raise CouldNotRun("me block is not a JSON object")
    if me is not None:
        mc = me.get("model_correction")
        if isinstance(mc, dict):
            out["correction"] = {"remaining": mc.get("remaining"), "resets_at": mc.get("resets_at")}
    if not equal and out["correction"] is not None:
        rem = out["correction"]["remaining"]
        if isinstance(rem, int) and not isinstance(rem, bool):
            out["action"] = "correct" if rem >= 1 else "blocked"
    if equal:
        out["correction"] = None
    return out


