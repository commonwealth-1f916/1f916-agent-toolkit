MIGRATION = re.compile(r"^(\d+)")


def docket_side(ctx, repo_dir, url, ref, full):
    sha = ctx.ls_remote(url, ref)
    fetch = ["fetch", "-q", "--no-tags"]
    if not full:
        fetch.append("--depth=1")
    ctx.git(fetch + [url, "refs/heads/%s:refs/checks/%s" % (ref, sha)], cwd=repo_dir)
    got = ctx.git(["rev-parse", "refs/checks/%s" % sha], cwd=repo_dir).strip()
    if got != sha:
        raise CouldNotRun("%s %s moved between ls-remote (%s) and fetch (%s)" % (url, ref, sha, got))
    listing = ctx.git(["ls-tree", "--name-only", sha, "migrations/"], cwd=repo_dir)
    files = sorted(os.path.basename(l) for l in listing.splitlines() if l.strip())
    by_num = {}
    width = 0
    for f in files:
        m = MIGRATION.match(f)
        if m:
            by_num.setdefault(int(m.group(1)), []).append(f)
            width = max(width, len(m.group(1)))
    newest = max(by_num) if by_num else None
    side = {"repo": url, "ref": ref, "sha": sha,
            "newest_migration": sorted(by_num[newest])[-1] if newest is not None else None,
            "newest_number": newest,
            "numbers": sorted(by_num)}
    return side, by_num, width


def cmd_docket(ctx, args):
    wd = ctx.workdir()
    repo_dir = os.path.join(wd, "docket")
    if os.path.exists(repo_dir):
        shutil.rmtree(repo_dir)
    ctx.git(["init", "-q", repo_dir])
    up, up_by, up_w = docket_side(ctx, repo_dir, args.upstream, args.upstream_ref, args.full)
    fk, fk_by, fk_w = docket_side(ctx, repo_dir, args.fork, args.fork_ref, args.full)
    shared = sorted(n for n in set(up_by) & set(fk_by) if sorted(up_by[n]) != sorted(fk_by[n]))
    nums = list(up_by) + list(fk_by)
    out = {
        "upstream": up,
        "fork": fk,
        "shared_numbers": shared,
        "shared_detail": dict((str(n), {"upstream": sorted(up_by[n]), "fork": sorted(fk_by[n])})
                              for n in shared),
        "upstream_newest_ge_fork_newest": (up["newest_number"] >= fk["newest_number"])
        if up["newest_number"] is not None and fk["newest_number"] is not None else None,
        "next_free": str(max(nums) + 1).zfill(max(up_w, fk_w)) if nums else None,
        "behind": None,
        "behind_reason": "not computed: shallow",
    }
    if args.full:
        out["behind"] = int(ctx.git(["rev-list", "--count", "%s..%s" % (fk["sha"], up["sha"])],
                                    cwd=repo_dir).strip())
        out["behind_reason"] = None
    return out


def cmd_push_verify(ctx, args):
    # A segment of only dots ('.', '..') is not a GitHub name and would be
    # normalised away by the URL; refused rather than resolved (review 12e).
    if (not re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", args.repo)
            or any(set(seg) == {"."} for seg in args.repo.split("/"))):
        raise UsageError("--repo wants OWNER/NAME, got %r" % args.repo)
    pairs = [split_pair(item, "--file") for item in args.file]
    git_url = args.git_base.rstrip("/") + "/" + args.repo
    sha = ctx.ls_remote(git_url, args.ref)
    files = {}
    for path, local in pairs:
        data = ctx.read_file(local, "local:" + path)
        remote = ctx.fetch("https://raw.githubusercontent.com/%s/%s/%s"
                           % (args.repo, sha, urllib.parse.quote(path.lstrip("/"))))
        files[path] = {"remote_sha256": sha256_hex(remote), "local_sha256": sha256_hex(data),
                       "match": sha256_hex(remote) == sha256_hex(data), "bytes": len(remote)}
    return {"repo": args.repo, "ref": args.ref, "sha": sha, "files": files,
            "all_match": all(f["match"] for f in files.values())}


def cmd_witness_gaps(ctx, args):
    since = None
    if args.since:
        since = parse_iso(args.since)
        if since is None:
            raise UsageError("--since is not ISO 8601: %r" % args.since)
    wd = ctx.workdir()
    clone = os.path.join(wd, "witness-gaps")
    if os.path.exists(clone):
        shutil.rmtree(clone)
    ctx.git(["clone", "-q", "--no-checkout", args.repo, clone])
    log = ctx.git(["log", "--reverse", "--format=%H %ct %at %P", "HEAD", "--", args.path], cwd=clone)
    commits = []
    for line in log.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        sha, ct, at = parts[0], int(parts[1]), int(parts[2])
        parent = parts[3] if len(parts) > 3 else None
        if since is not None and ct < since.timestamp():
            continue
        commits.append((sha, ct, at, parent))
    gap = float(args.gap_minutes)
    gaps = []
    max_c = None
    max_a = None
    for a, b in zip(commits, commits[1:]):
        exact = (b[1] - a[1]) / 60.0
        mc = round(exact, 1)
        ma = round((b[2] - a[2]) / 60.0, 1)
        max_c = mc if max_c is None else max(max_c, mc)
        max_a = ma if max_a is None else max(max_a, ma)
        if exact >= gap:
            gaps.append({"from_sha": a[0], "to_sha": b[0], "from": epoch_iso(a[1]),
                         "to": epoch_iso(b[1]), "minutes": mc})
    # Drop-one-tick counterfactual: remove each interior commit in turn and ask
    # whether the gap it leaves would be reported. This is the rule's recall
    # for the failure it exists to catch, measured on the history in front of it.
    silent = []
    positions = max(len(commits) - 2, 0)
    for i in range(1, len(commits) - 1):
        merged = (commits[i + 1][1] - commits[i - 1][1]) / 60.0
        if merged < gap:
            silent.append({"dropped_sha": commits[i][0], "merged_minutes": round(merged, 1)})
    sensitivity = {
        "positions": positions,
        "detected": positions - len(silent),
        "silent": len(silent),
        "rate": round((positions - len(silent)) / float(positions), 4) if positions else None,
        "silent_examples": silent[:3],
    }
    # One `git log --numstat` for every commit instead of one `git diff` per
    # commit (review 12a; the walk was past 580 processes). `-m --first-parent`
    # diffs a merge against its first parent, which is what the per-commit
    # `diff <first parent> <sha>` did, and a root commit is diffed against the
    # empty tree either way. Only the commits kept above are read.
    stats = ctx.git(["log", "-m", "--first-parent", "--numstat", "--format=@@%H",
                     "HEAD", "--", args.path], cwd=clone)
    per_commit = {}
    current = None
    for line in stats.splitlines():
        if line.startswith("@@"):
            current = line[2:].strip()
            per_commit.setdefault(current, [])
        elif current is not None and line.strip():
            per_commit[current].append(line)
    non_append = []
    for sha, ct, _at, _parent in commits:
        for line in per_commit.get(sha, []):
            cols = line.split("\t")
            if len(cols) >= 3 and (cols[1] == "-" or int(cols[1]) > 0):
                non_append.append({"sha": sha, "at": epoch_iso(ct), "deletions": cols[1]})
    return {
        "repo": args.repo, "path": args.path,
        "since": iso(since) if since else None,
        "gap_minutes": gap,
        "gap_rule": "minutes >= gap_minutes, committer clock",
        "commits": len(commits),
        "first": epoch_iso(commits[0][1]) if commits else None,
        "last": epoch_iso(commits[-1][1]) if commits else None,
        "max_gap_minutes": max_c,
        "gaps_over": gaps,
        "sensitivity_at_unit_failure": sensitivity,
        "non_append_commits": non_append,
        "author_clock_max_gap_minutes": max_a,
    }


