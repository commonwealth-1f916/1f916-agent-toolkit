JUDGEMENT_FIELDS_BY_KIND = {
    "daily": (DAILY_JUDGEMENT_FIELDS, DAILY_JUDGEMENT_NESTED),
    "audit": (AUDIT_JUDGEMENT_FIELDS, ()),
