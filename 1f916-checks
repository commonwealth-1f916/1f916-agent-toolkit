# window

def load_triggers(obj):
    if isinstance(obj, list) and obj and all(isinstance(x, dict) and "text" in x for x in obj):
        texts = [x["text"] for x in obj]
        try:
            obj = json.loads(texts[0] if len(texts) == 1 else "".join(texts))
        except ValueError:
            raise CouldNotRun("trigger JSON wrapper text is not JSON")
    if isinstance(obj, dict):
        for k in ("triggers", "data"):
            if isinstance(obj.get(k), list):
                return obj[k]
    if isinstance(obj, list):
        return obj
    raise CouldNotRun("no triggers or data list in the trigger JSON")


def cmd_window(ctx, args):
    triggers = load_triggers(ctx.read_json(args.trigger_json, "trigger-json"))
    hits = [t for t in triggers if isinstance(t, dict) and str(t.get("name", "")).startswith(args.name_prefix)]
    if len(hits) != 1:
        raise CouldNotRun("expected exactly one trigger named %r..., found %d" % (args.name_prefix, len(hits)))
    t = hits[0]
    lr = t.get("last_run") if isinstance(t.get("last_run"), dict) else None
    reasons = []
    out = {"name": t.get("name"), "id": t.get("id"), "last_run": None, "lifetime_seconds": None,
           "hours_since_fired": None}
    if lr is None:
        reasons.append("no last_run recorded")
    else:
        out["last_run"] = dict((k, lr.get(k)) for k in ("status", "fired_at", "finished_at", "session_id"))
        fired = ms_or_iso(lr.get("fired_at"))
        finished = ms_or_iso(lr.get("finished_at"))
        if fired is not None and finished is not None:
            out["lifetime_seconds"] = round((finished - fired).total_seconds(), 1)
        if fired is not None:
            out["hours_since_fired"] = round((ctx.now - fired).total_seconds() / 3600.0, 2)
        if str(lr.get("status", "")).upper() == "FAILED":
            reasons.append("last_run status FAILED")
        if fired is None:
            reasons.append("fired_at absent or unparseable")
        elif out["hours_since_fired"] > 24:
            reasons.append("fired_at more than 24 h ago")
        if out["lifetime_seconds"] is not None and out["lifetime_seconds"] < args.lifetime_dark_seconds:
            reasons.append("lifetime under %s s" % args.lifetime_dark_seconds)
    if args.runs_row == "absent":
        reasons.append("runs row absent")
    out["runs_row"] = args.runs_row
    out["dark"] = bool(reasons)
    out["dark_reasons"] = reasons
    return out


