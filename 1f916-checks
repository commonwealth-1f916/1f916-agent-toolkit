def emit(obj):
    sys.stdout.write(json.dumps(obj, indent=1, sort_keys=True, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def main(argv=None):
    args = build_parser().parse_args(argv)
    base = {"check": args.check, "version": VERSION, "status": "ok", "reason": None}
    ctx = None
    try:
        ctx = Ctx(args)
        result = COMMANDS[args.check](ctx, args)
    except UsageError as e:
        sys.stderr.write("1f916-checks %s: error: %s\n" % (args.check, e))
        return EXIT_USAGE
    except (KeyError, TypeError, ValueError, AttributeError) as e:
        # A payload of a shape nobody anticipated. Said as not-run, never as ok.
        base.update(status="could_not_run", reason="unexpected input shape: %s: %s"
                    % (type(e).__name__, e), inputs=ctx.inputs if ctx else {"urls": [], "files": []})
        emit(base)
        return EXIT_NOT_RUN
    except CouldNotRun as e:
        base.update(status="could_not_run", reason=str(e),
                    inputs=ctx.inputs if ctx else {"urls": [], "files": []})
        emit(base)
        return EXIT_NOT_RUN
    finally:
        if ctx is not None:
            ctx.cleanup()
    override = result.pop("status_override", None)
    reason_override = result.pop("reason_override", None)
    for k in base:
        result.pop(k, None)
    result.update(base)
    if override:
        result["status"] = override
        result["reason"] = reason_override
    result["inputs"] = ctx.inputs
    emit(result)
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
