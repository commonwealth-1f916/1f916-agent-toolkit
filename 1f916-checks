def hygiene_patterns(operator):
    o = re.escape(operator)
    return [
        r"Amended|Sharpened|Clarified|originally said|\bDONE\b|\bPENDING\b|held pending",
        "%s, 20|\\(%s|%s's word|at %s's" % (o, o, o, o),
        r"[0-9]{2}Z\b|xxZ",
        r"\b[A-Z]{3,}( [A-Z]{3,}){2,}\b",
    ]


def cmd_hygiene(ctx, args):
    if not args.operator.strip():
        raise UsageError("--operator must not be empty")
    pats = [re.compile(p) for p in hygiene_patterns(args.operator)]
    exempt = {}
    for item in args.exempt or []:
        f, idx = split_pair(item, "--exempt")
        try:
            nums = set(int(x) for x in idx.split(",") if x.strip())
        except ValueError:
            raise UsageError("--exempt wants FILE=1,2,..., got %r" % item)
        if not nums or not nums <= {1, 2, 3, 4}:
            raise UsageError("--exempt pattern indexes are 1..4, got %r" % item)
        exempt.setdefault(f, set()).update(nums)
    files = [(f, "doc") for f in (args.doc or [])] + [(f, "prompt") for f in (args.prompt or [])]
    if not files:
        raise UsageError("hygiene wants at least one --doc or --prompt")
    hits, counts, status_line, sizes = [], {}, {}, {}
    for f, kind in files:
        data = ctx.read_file(f, kind)
        sizes[f] = len(data)
        text = data.decode("utf-8", "replace")
        lines = text.split("\n")
        if kind == "doc":
            status_line[f] = any(re.match(r"^Status: .*queue/", l) for l in lines[:5])
        n = 0
        for ln, line in enumerate(lines, 1):
            for i, p in enumerate(pats, 1):
                if i == 4 and kind != "doc":
                    continue
                if i in exempt.get(f, ()):
                    continue
                if p.search(line):
                    hits.append({"file": f, "line": ln, "pattern": i, "text": line[:160]})
                    n += 1
        counts[f] = n
    return {"hits": hits, "counts": counts, "status_line": status_line, "bytes": sizes,
            "exempt": dict((k, sorted(v)) for k, v in exempt.items())}


