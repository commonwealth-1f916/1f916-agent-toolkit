def _dig(obj, path):
    """Follow a str key or a tuple of keys. Absent is None, never an error."""
    if isinstance(path, str):
        path = (path,)
    for key in path:
        if not isinstance(obj, dict) or key not in obj:
            return None
        obj = obj[key]
    return obj


# The fields DAILY_JUDGEMENT_NESTED names are the run's to write, by this
# file's own reckoning, so a judgement carrying one is doing its job and is
# never a collision -- even where the builder also derives it from a part.
RUN_WRITABLE_FIELDS = frozenset(
    "%s.%s" % pair for pair in DAILY_JUDGEMENT_NESTED)


def _judgement_collisions(produced, judgement):
    """The (block, field) pairs a judgement would replace that a check MEASURED.

    The table above says the builder must never decide a verdict. The same
    reasoning cuts the other way and nothing enforced it until now: the caller
    is a scheduled run, and a judgement file carrying {"homepage": {"agree":
    true}} or {"witness": {"fresh": true}} replaced a measured value with an
    asserted one and left no trace, because `judgement_applied` lists
    TOP-LEVEL keys only -- the row did not say which mechanical field had
    moved. Raising is what the rest of this file does with an input it cannot
    honour, and a row that cannot be built is a cell the run reports as
    could-not-run rather than a row that reads as measurement.

    Found by the 2026-09-20 review, finding 3, in code shipped the same day.
    """
    hits = []
    for key, value in judgement.items():
        fields = produced.get(key)
        if not fields:
            continue
        if isinstance(value, dict):
            candidates = [f for f in value if f in fields]
        else:
            # the whole block replaced by a scalar or a list: all of it goes
            candidates = list(fields)
        hits.extend("%s.%s" % (key, f) for f in candidates
                    if "%s.%s" % (key, f) not in RUN_WRITABLE_FIELDS)
    return sorted(hits)


def _deep_merge(base, overlay):
    """overlay wins. Dicts merge; everything else replaces."""
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            _deep_merge(base[key], value)
        else:
            base[key] = value
    return base


def cmd_runs_row(ctx, args):
    """Assemble the mechanical blocks of a runs row from an `all` output.

    Emits {"row": ..., ...}: the row is NESTED so that a field of the row can
    never collide with this program's own check/status/version keys. The caller
    writes `.row`, having merged its own judgement into it.
    """
    payload = ctx.read_json(args.all, "all output")
    parts = payload.get("parts")
    if not isinstance(parts, dict):
        raise CouldNotRun("all output has no `parts` object: %s" % args.all)

    row = {}
    produced, absent = {}, {}
    for block, fields in RUNS_ROW_MAP.items():
        source = RUNS_ROW_SOURCE.get(block, block)
        part = parts.get(source)
        if not isinstance(part, dict) or part.get("status") != "ok":
            absent[block] = ("part %s did not run" % source if part is None or
                             not isinstance(part, dict) else
                             "part %s: %s" % (source, part.get("reason")))
            continue
        built = {}
        for name, path in fields.items():
            built[name] = _dig(part, path)
        row[block] = built
        produced[block] = sorted(built)

    # Derived fields: a restatement rather than a computation.
    if "witness" in row and isinstance(parts.get("witness"), dict):
        bucket = parts["witness"].get("freshness")
        # The row has carried `fresh` as a boolean since it was first written,
        # and a boolean cannot tell LATE from STALE -- one is a non-alarm and
        # the other is not. Both are emitted: `fresh` keeps the shape every
        # reader of the row already expects, `freshness` stops the bucket being
        # discarded on the way in.
        row["witness"]["fresh"] = (bucket == "FRESH") if bucket is not None else None
        row["witness"]["freshness"] = bucket
        produced["witness"] = sorted(row["witness"])
    if "bindings" in row and isinstance(parts.get("bindings"), dict):
        rows = parts["bindings"].get("bindings")
        if isinstance(rows, list):
            row["bindings"]["domains"] = [r.get("domain") for r in rows
                                          if isinstance(r, dict)]
            produced["bindings"] = sorted(row["bindings"])
    if "previous_window" in row and isinstance(parts.get("window"), dict):
        win = parts["window"]
        last = win.get("last_run") or {}
        row["previous_window"]["task"] = "%s (%s)" % (win.get("name"), win.get("id"))
        for name in ("fired_at", "finished_at"):
            row["previous_window"][name] = last.get(name)
        row["previous_window"]["last_run_status"] = last.get("status")
        produced["previous_window"] = sorted(row["previous_window"])
    if "front" in row:
        row["front"]["limit"] = args.front_limit
        produced["front"] = sorted(row["front"])

    if args.docket:
        docket = ctx.read_json(args.docket, "docket output")
        if isinstance(docket, dict):
            row["docket"] = dict((k, v) for k, v in docket.items()
                                 if k not in ("check", "version", "status", "reason", "inputs"))
            produced["docket"] = sorted(row["docket"])

    judgement = {}
    if args.judgement:
        judgement = ctx.read_json(args.judgement, "judgement")
        if not isinstance(judgement, dict):
            raise CouldNotRun("judgement is not a JSON object: %s" % args.judgement)
        clash = _judgement_collisions(produced, judgement)
        if clash:
            raise CouldNotRun(
                "judgement would overwrite measured field(s): %s -- a check "
                "produced each of these and the row must carry what was "
                "measured, not what the run asserts. Remove them from the "
                "judgement; if a measurement is wrong, fix the check or "
                "report the disagreement in a field of your own."
                % ", ".join(clash))
        _deep_merge(row, judgement)

    missing = None
    missing_reason = None
    if args.kind in JUDGEMENT_FIELDS_BY_KIND:
        flat, nested = JUDGEMENT_FIELDS_BY_KIND[args.kind]
        missing = [f for f in flat if row.get(f) is None]
        for block, field in nested:
            if _dig(row, (block, field)) is None:
                missing.append("%s.%s" % (block, field))
        missing.sort()
    else:
        # Not an error: the kind is valid and the row is built. What is absent
        # is the FIELD LIST for it, and a null with no reason reads as "nothing
        # missing" to anyone who does not know the table.
        missing_reason = ("no judgement field list is defined for kind %r, so "
                          "this is 'not checked', not 'nothing missing'" % args.kind)

    out = {"row": row, "blocks_built": produced, "blocks_absent": absent,
           "judgement_missing": missing,
           "judgement_applied": sorted(judgement) if judgement else []}
    if missing_reason:
        out["judgement_missing_reason"] = missing_reason
    return out


# ---------------------------------------------------------------------------
# changes-sweep: the nulls walk, pinned
#
# GET /api/changes carries the registry's nulls log (refused writes,
# depth-ejections, rotations, tombstones) on its own row-id cursor. The walk
# silences the posts and comments streams, starts at ?since=<ms> and then sends
# back next_nulls_since EXACTLY as served -- the cursor is opaque here and is
# never rebuilt from a row id or re-initialised from --since. It stops when a
# page says has_more is false or carries no rows.
#
# The counts are totals only when the walk drained the stream: has_more false
# at the end AND at least as many rows read as the first page's nulls_total.
# Anything short of that is a floor, and `counts_are` says which.

NULL_ROUTE_KEYS = ("route",)
NULL_TS_KEYS = ("at", "ts", "created_at", "occurred_at")
NULL_REASON_KEYS = ("reason", "error")
SWEEP_STATE_VERSION = 2


class _Http429(Exception):
    def __init__(self, retry_after):
        Exception.__init__(self, "HTTP 429")
        self.retry_after = retry_after


def _retry_after_seconds(value):
    if value is None:
        return None
    try:
        return max(0.0, float(str(value).strip()))
    except ValueError:
        return None


def _sweep_fetch(ctx, url):
    """One GET of one page. Raises _Http429 on a 429, CouldNotRun otherwise.

    Offline (tests): DIR/<sha256 of url> is the body; DIR/<sha256>.status, when
    present, holds lines `429 <retry-after>` served in order before the body,
    once each per process."""
    rec = {"url": url, "status": None, "bytes": None, "sha256": None}
    ctx.inputs["urls"].append(rec)
    if ctx.offline_dir:
        stem = os.path.join(ctx.offline_dir, sha256_hex(url.encode("utf-8")))
        queue = getattr(ctx, "_offline_status", {})
        ctx._offline_status = queue
        if stem not in queue:
            try:
                with open(stem + ".status", "r") as fh:
                    queue[stem] = [ln.split() for ln in fh.read().splitlines() if ln.strip()]
            except OSError:
                queue[stem] = []
        if queue[stem]:
            parts = queue[stem].pop(0)
            rec["status"] = int(parts[0])
            if rec["status"] == 429:
                raise _Http429(_retry_after_seconds(parts[1] if len(parts) > 1 else None))
            raise CouldNotRun("fetch failed: HTTP %d from %s" % (rec["status"], url))
        try:
            with open(stem, "rb") as fh:
                body = fh.read()
        except OSError:
            raise CouldNotRun("fetch failed: %s (offline file absent)" % url)
        rec.update(status=200, bytes=len(body), sha256=sha256_hex(body))
        return body
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=ctx.timeout) as resp:
            body = resp.read()
            status = resp.status
    except urllib.error.HTTPError as e:
        rec["status"] = e.code
        if e.code == 429:
            raise _Http429(_retry_after_seconds(e.headers.get("Retry-After") if e.headers else None))
        raise CouldNotRun("fetch failed: HTTP %d from %s" % (e.code, url))
    except (urllib.error.URLError, OSError) as e:
        raise CouldNotRun("fetch failed: %s from %s" % (getattr(e, "reason", e), url))
    rec.update(status=status, bytes=len(body), sha256=sha256_hex(body))
    if not 200 <= status < 300:
        raise CouldNotRun("fetch failed: HTTP %d from %s" % (status, url))
    return body


def _null_field(row, keys):
    for k in keys:
        if row.get(k) is not None:
            return row[k]
    return None


def _null_route(row):
    route = _null_field(row, NULL_ROUTE_KEYS)
    if isinstance(route, str):
        return route
    method, path = row.get("method"), row.get("path")
    if isinstance(method, str) and isinstance(path, str):
        return "%s %s" % (method, path)
    return None


def _sweep_page_url(args, cursor):
    url = "%s/api/changes?since=%d&posts_since=done&comments_since=done" % (REGISTRY, args.since_ms)
    if cursor is not None:
        url += "&nulls_since=" + urllib.parse.quote(str(cursor), safe=":")
    return url


def _sweep_query(args):
    return {"since_ms": args.since_ms, "route": args.route, "status": args.status,
            "reason_prefix": args.reason_prefix,
            "cutoff": iso(args.cutoff_dt) if args.cutoff_dt else None}


def _write_json_atomic(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(obj, fh, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def cmd_changes_sweep(ctx, args):
    if not args.route or not args.route.strip():
        raise UsageError("--route is required and may not be empty")
    since_dt = ms_or_iso(int(args.since)) if re.match(r"^\d+$", args.since) else parse_iso(args.since)
    if since_dt is None:
        raise UsageError("--since wants epoch ms or ISO 8601, got %r" % args.since)
    args.since_ms = int(args.since) if re.match(r"^\d+$", args.since) else int(
        round(since_dt.timestamp() * 1000))
    args.cutoff_dt = None
    if args.cutoff:
        args.cutoff_dt = parse_iso(args.cutoff)
        if args.cutoff_dt is None:
            raise UsageError("--cutoff is not ISO 8601: %r" % args.cutoff)
    query = _sweep_query(args)

    st = None
    if args.state and os.path.exists(args.state):
        st = ctx.read_json(args.state, "state")
        if not isinstance(st, dict) or st.get("version") != SWEEP_STATE_VERSION:
            raise CouldNotRun("state file is not a changes-sweep state: %s" % args.state)
        if st.get("query") != query:
            raise CouldNotRun("state file belongs to a different walk (%s); "
                              "name a new --state to start this one" % json.dumps(st.get("query")))
    if st is None:
        st = {"version": SWEEP_STATE_VERSION, "query": query, "cursor": None, "started": False,
              "finished": False, "has_more": None, "pages": 0, "rows_read": 0,
              "first_page_nulls_total": None, "matched": 0, "by_day_utc": {},
              "first_ts": None, "last_ts": None, "before_cutoff": 0, "after_cutoff": 0,
              "reasons": {}, "http429": 0, "out_bytes": 0, "skipped_by_kind": {}}

    out_fh = None
    if args.out:
        # Resume discards whatever the dead walk appended after its last
        # committed page, so a page is never in the file twice.
        mode = "r+b" if (st["started"] and os.path.exists(args.out)) else "wb"
        out_fh = open(args.out, mode)
        out_fh.seek(st["out_bytes"] if mode == "r+b" else 0)
        out_fh.truncate()

    stopped = None
    try:
        while not st["finished"]:
            if st["pages"] >= args.max_pages:
                stopped = "max-pages %d reached" % args.max_pages
                break
            if st["started"] and args.pace > 0:
                time.sleep(args.pace)
            url = _sweep_page_url(args, st["cursor"])
            body = None
            for attempt in range(args.max_429 + 1):
                try:
                    body = _sweep_fetch(ctx, url)
                    break
                except _Http429 as e:
                    st["http429"] += 1
                    if attempt == args.max_429:
                        break
                    wait = e.retry_after
                    if wait is None:
                        wait = args.backoff * (2 ** attempt)
                    time.sleep(min(wait, 300.0))
                except CouldNotRun:
                    if not st["started"]:
                        raise
                    stopped = "page %d: %s" % (st["pages"] + 1, ctx.inputs["urls"][-1]["url"])
                    break
            if stopped:
                break
            if body is None:
                if not st["started"]:
                    raise CouldNotRun("first page answered 429 %d times" % (args.max_429 + 1))
                stopped = "page %d: 429 %d times running" % (st["pages"] + 1, args.max_429 + 1)
                break
            try:
                page = json.loads(body.decode("utf-8"))
            except ValueError as e:
                if not st["started"]:
                    raise CouldNotRun("unparseable JSON from %s: %s" % (url, e))
                stopped = "page %d: unparseable JSON" % (st["pages"] + 1)
                break
            if not isinstance(page, dict) or not isinstance(page.get("nulls"), list):
                raise CouldNotRun("page %d has no nulls[] list" % (st["pages"] + 1))
            rows = page["nulls"]
            if not st["started"]:
                if not rows:
                    raise CouldNotRun("the first page carried no nulls rows; nothing was walked")
                total = page.get("nulls_total")
                if isinstance(total, int) and not isinstance(total, bool):
                    st["first_page_nulls_total"] = total
            matched_rows = []
            for row in rows:
                if not isinstance(row, dict):
                    raise CouldNotRun("a nulls row is not an object (page %d)" % (st["pages"] + 1))
                ts = ms_or_iso(_null_field(row, NULL_TS_KEYS))
                if ts is None:
                    raise CouldNotRun("a nulls row has no timestamp (page %d, keys %s)"
                                      % (st["pages"] + 1, sorted(row)))
                route = _null_route(row)
                if route is None:
                    # The log is not only refusals: depth_ejection, key_rotation
                    # and tombstone rows carry no route (nulls_declared_kinds).
                    # They are counted by kind and walked past, never a stop --
                    # the live first page holds one and a stop there would end
                    # every real walk on page 1.
                    kind = row.get("kind") if isinstance(row.get("kind"), str) else "?"
                    st["skipped_by_kind"][kind] = st["skipped_by_kind"].get(kind, 0) + 1
                    continue
                if route != args.route:
                    continue
                if args.status is not None and row.get("status") != args.status:
                    continue
                reason = _null_field(row, NULL_REASON_KEYS)
                reason = reason if isinstance(reason, str) else ""
                if args.reason_prefix is not None and not reason.startswith(args.reason_prefix):
                    continue
                matched_rows.append(row)
                st["matched"] += 1
                day = ts.strftime("%Y-%m-%d")
                st["by_day_utc"][day] = st["by_day_utc"].get(day, 0) + 1
                stamp = iso(ts)
                if st["first_ts"] is None or stamp < st["first_ts"]:
                    st["first_ts"] = stamp
                if st["last_ts"] is None or stamp > st["last_ts"]:
                    st["last_ts"] = stamp
                if args.cutoff_dt is not None:
                    st["before_cutoff" if ts < args.cutoff_dt else "after_cutoff"] += 1
                key = reason[:80]
                st["reasons"][key] = st["reasons"].get(key, 0) + 1
            if out_fh is not None:
                for row in matched_rows:
                    out_fh.write((json.dumps(row, sort_keys=True) + "\n").encode("utf-8"))
                out_fh.flush()
                st["out_bytes"] = out_fh.tell()
            st["started"] = True
            st["pages"] += 1
            st["rows_read"] += len(rows)
            st["has_more"] = page.get("has_more") is True
            nxt = page.get("next_nulls_since")
            if not rows or not st["has_more"]:
                st["finished"] = True
            elif nxt is None or nxt == st["cursor"]:
                stopped = "page %d: has_more true but %s" % (
                    st["pages"], "no next_nulls_since" if nxt is None else "the cursor did not advance")
            else:
                st["cursor"] = nxt
            if args.state:
                _write_json_atomic(args.state, st)
            if stopped:
                break
    finally:
        if out_fh is not None:
            out_fh.close()

    complete = bool(st["finished"] and st["has_more"] is False
                    and st["first_page_nulls_total"] is not None
                    and st["rows_read"] >= st["first_page_nulls_total"])
    out = {
        "query": query,
        "pages": st["pages"],
        "rows_read": st["rows_read"],
        "first_page_nulls_total": st["first_page_nulls_total"],
        "has_more_at_end": st["has_more"],
        "complete": complete,
        "counts_are": "totals" if complete else "floors",
        "matched": st["matched"],
        "by_day_utc": dict(sorted(st["by_day_utc"].items())),
        "first_ts": st["first_ts"],
        "last_ts": st["last_ts"],
        "before_cutoff": st["before_cutoff"] if args.cutoff_dt else None,
        "after_cutoff": st["after_cutoff"] if args.cutoff_dt else None,
        "reasons": st["reasons"],
        "skipped_by_kind": st["skipped_by_kind"],
        "http429": st["http429"],
        "stopped_early": stopped,
        "cursor_end": st["cursor"],
        "out": args.out,
        "state": args.state,
    }
    if not complete:
        # A partial walk HAS a partial result, which exit 3 promises it has not.
        out["status_override"] = "degraded"
        out["reason_override"] = stopped or (
            "walk ended with has_more true" if st["has_more"] else
            "rows_read %d is below the first page's nulls_total %s"
            % (st["rows_read"], st["first_page_nulls_total"]))
    return out


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        sys.stderr.write("%s: error: %s\n" % (self.prog, message))
        sys.exit(EXIT_USAGE)


def common_parser():
    """A FRESH parent per subcommand.

    One shared parent would be cheaper and is what this did until 2026-09-20.
    `parents=` copies action objects by reference, and argparse's set_defaults
    reaches into the action it finds and rewrites its default -- so the 120 s
    timeout the bindings subparser sets for itself silently became the default
    for all seventeen checks. Building a parent per subcommand is what keeps a
    per-subcommand default per-subcommand.
    """
    common = Parser(add_help=False)
    common.add_argument("--offline-dir", help="read every fetch from DIR/<sha256 of url> (tests)")
    common.add_argument("--now", help="ISO 8601 clock override (tests)")
    common.add_argument("--workdir", help="the only directory written to (git subcommands)")
    common.add_argument("--timeout", type=float, default=30.0, help="per-request seconds (default 30)")
    return common


def build_parser():

    p = Parser(prog="1f916-checks", description="Unauthenticated, mechanical checks. One JSON object on stdout.")
    sub = p.add_subparsers(dest="check", metavar="SUBCOMMAND", parser_class=Parser)
    sub.required = True

    s = sub.add_parser("surface", parents=[common_parser()])
    s.add_argument("--prior")
    s.add_argument("--emit-baseline", action="store_true")

    s = sub.add_parser("official", parents=[common_parser()])
    s.add_argument("--prior")
    s.add_argument("--emit-baseline", action="store_true")

    s = sub.add_parser("witness", parents=[common_parser()])
    s.add_argument("--prior")
    s.add_argument("--url", required=True, help="raw URL of countersignatures.jsonl")

    s = sub.add_parser("hashes", parents=[common_parser()])
    s.add_argument("--url", action="append", required=True, metavar="NAME=URL")
    s.add_argument("--expect", action="append", metavar="NAME=SHA256")
    s.add_argument("--cache-bust", action="append", metavar="NAME")

    s = sub.add_parser("seal", parents=[common_parser()])
    s.add_argument("--label", required=True)
    s.add_argument("--citizen", default="commonwealth")
    s.add_argument("--preimage")

