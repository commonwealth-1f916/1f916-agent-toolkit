def as_int_ids(values, what):
    out = []
    for v in values:
        try:
            out.append(int(str(v).strip()))
        except ValueError:
            raise CouldNotRun("%s holds a non-integer id: %r" % (what, v))
    return out


def cmd_front(ctx, args):
    front = ctx.fetch_json(REGISTRY + "/api/front?limit=100")
    new = ctx.fetch_json(REGISTRY + "/api/new")
    if not isinstance(front, dict) or not isinstance(front.get("posts"), list):
        raise CouldNotRun("front payload has no posts[] list")
    if not isinstance(new, dict) or "pin_snapshot" not in new:
        raise CouldNotRun("/api/new payload has no pin_snapshot")
    cmap = {}
    pinned = []
    for p in front["posts"]:
        if not isinstance(p, dict) or "id" not in p:
            raise CouldNotRun("a front post has no id")
        pid = as_int_ids([p["id"]], "front")[0]
        c = p.get("comments")
        if isinstance(c, bool) or not isinstance(c, int):
            raise CouldNotRun("front post %d has no integer comments" % pid)
        cmap[pid] = c
        if p.get("pinned"):
            pinned.append(pid)
    snap = new.get("pin_snapshot") or ""
    if isinstance(snap, list):
        snap_ids = as_int_ids(snap, "pin_snapshot")
    else:
        snap_ids = as_int_ids([s for s in str(snap).split(",") if s.strip()], "pin_snapshot")
    board_total = front.get("board_total", new.get("board_total"))
    out = {
        "rows": len(front["posts"]),
        "map": dict((str(k), cmap[k]) for k in sorted(cmap)),
        "pinned_in_window": sorted(pinned),
        "pin_snapshot": sorted(snap_ids),
        "pinned_extra": new.get("pinned_extra"),
        "board_total": board_total,
    }
    for k in ("delta", "new_ids", "dropped_ids", "pins_added", "pins_removed",
              "pins_prior_missing", "read_ids_delta"):
        out[k] = None
    out["baseline_missing"] = []
    read_ids = None
    if args.read_ids is not None:
        read_ids = as_int_ids([s for s in args.read_ids.split(",") if s.strip()], "--read-ids")
    prior = ctx.read_row(args.prior)
    if prior is None:
        out["baseline_missing"] = ["prior"]
    else:
        pmap = prior.get("map")
        if isinstance(pmap, dict):
            pm = dict(zip(as_int_ids(list(pmap.keys()), "prior map"), pmap.values()))
            both = sorted(set(pm) & set(cmap))
            rows = [{"id": i, "prior": pm[i], "now": cmap[i], "delta": cmap[i] - pm[i]}
                    for i in both if isinstance(pm[i], int)]
            rows.sort(key=lambda r: (-r["delta"], r["id"]))
            out["delta"] = rows
            out["new_ids"] = sorted(set(cmap) - set(pm))
            out["dropped_ids"] = sorted(set(pm) - set(cmap))
        else:
            out["baseline_missing"].append("map")
        ppins = prior.get("pins")
        if isinstance(ppins, list):
            pp = set(as_int_ids(ppins, "prior pins"))
            out["pins_prior_missing"] = False
            out["pins_added"] = sorted(set(snap_ids) - pp)
            out["pins_removed"] = sorted(pp - set(snap_ids))
        else:
            out["pins_prior_missing"] = True
            out["baseline_missing"].append("pins")
        pread = prior.get("read_ids")
        if isinstance(pread, list):
            out["read_ids_delta"] = dict((str(i), cmap.get(i))
                                         for i in as_int_ids(pread, "prior read_ids"))
            if read_ids is None:
                read_ids = as_int_ids(pread, "prior read_ids")
        else:
            out["baseline_missing"].append("read_ids")
    out["baseline"] = {"map": out["map"], "pins": out["pin_snapshot"], "read_ids": read_ids,
                       "limit": 100, "board_total": board_total}
    return out


