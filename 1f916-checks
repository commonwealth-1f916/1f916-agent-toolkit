# manifest -- a set of documents against the digests a manifest claims for them

MANIFEST_LINE_RE = re.compile(r"^([0-9a-f]{64})  (\S.*)$")


def parse_manifest(text):
    """[(path, sha256)] from `<sha256>  <path>` lines; blank and # lines skipped.

    Refuses rather than tolerates: a malformed line, a duplicate path, an
    absolute or parent-relative path, or no entries at all. A manifest that
    verifies nothing must not print a clean result.
    """
    entries = []
    seen = set()
    for n, line in enumerate(text.split("\n"), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = MANIFEST_LINE_RE.match(line)
        if not m:
            raise CouldNotRun("manifest line %d is not `<sha256>  <path>`" % n)
        digest, path = m.group(1), m.group(2)
        if path.startswith("/") or path.startswith("../") or "/../" in path or path == "..":
            raise CouldNotRun("manifest line %d names a path outside the set: %s" % (n, path))
        if path in seen:
            raise CouldNotRun("manifest names %s twice" % path)
        seen.add(path)
        entries.append((path, digest))
    if not entries:
        raise CouldNotRun("manifest has no entries; it verifies nothing")
    return entries


def cmd_manifest(ctx, args):
    """Verify every file a manifest names, from a directory or from a base URL.

    Two modes, exactly one of them: --dir hashes local files and also reports
    files the directory holds that the manifest does not name (`extra`);
    --base fetches `<base>/<path>` for each entry the way a scheduled run
    fetches its docs at a pinned commit. Either way the output is the four
    disjoint lists and `all_match`, which is true only when every entry
    matched and nothing is missing -- `extra` files do not fail a fetch-mode
    check because a fetch cannot see them, and do fail a --dir check because
    an unmanifested doc beside the manifested ones is the drift this exists
    to catch. `computed` (--dir only) is the manifest the directory would
    produce, so a caller can regenerate the file from this one recipe.
    """
    if bool(args.dir) == bool(args.base):
        raise UsageError("give exactly one of --dir or --base")
    text = ctx.read_file(args.manifest, "manifest").decode("utf-8", "replace")
    manifest_sha = ctx.inputs["files"][-1]["sha256"]
    entries = parse_manifest(text)
    matched, mismatched, missing, extra, computed = [], [], [], [], []
    if args.dir:
        if not os.path.isdir(args.dir):
            raise CouldNotRun("--dir is not a directory: %s" % args.dir)
        present = {}
        for root, dirs, files in os.walk(args.dir):
            dirs.sort()
            for name in sorted(files):
                full = os.path.join(root, name)
                rel = os.path.relpath(full, args.dir).replace(os.sep, "/")
                if os.path.abspath(full) == os.path.abspath(args.manifest):
                    continue
                if not name.endswith(args.suffix):
                    continue
                with open(full, "rb") as fh:
                    present[rel] = sha256_hex(fh.read())
        for rel in sorted(present):
            computed.append({"path": rel, "sha256": present[rel]})
        named = set()
        for path, want in entries:
            named.add(path)
            got = present.get(path)
            if got is None:
                missing.append(path)
            elif got == want:
                matched.append(path)
            else:
                mismatched.append({"path": path, "expected": want, "actual": got})
        extra = sorted(p for p in present if p not in named)
    else:
        base = args.base.rstrip("/")
        for path, want in entries:
            url = base + "/" + path
            try:
                body = ctx.fetch(url)
            except CouldNotRun as e:
                rec = ctx.inputs["urls"][-1] if ctx.inputs["urls"] else {}
                if rec.get("url") == url and rec.get("status") == 404:
                    missing.append(path)
                    continue
                raise
            got = sha256_hex(body)
            if got == want:
                matched.append(path)
            else:
                mismatched.append({"path": path, "expected": want, "actual": got})
    all_match = (not mismatched and not missing and (not args.dir or not extra))
    out = {"manifest_sha256": manifest_sha, "entries": len(entries), "mode": "dir" if args.dir else "base",
           "matched": matched, "mismatched": mismatched, "missing": missing, "extra": extra,
           "all_match": all_match}
    if args.dir:
        out["computed"] = computed
    return out


# ---------------------------------------------------------------------------
# prompt-integrity -- the stored prompts against the ledger rows that describe them

SHA256_RE = re.compile(r"^[0-9a-f]{64}$")


def load_trigger_prompts(obj):
    """[(id, name, prompt)] from a raw list_triggers payload.

    RAW, not the slim file the daily and evening runs save: this is the one
    check that needs derived_state.prompt, and it still never reads the text --
    it measures it here and emits numbers.
    """
    rows = obj.get("data") if isinstance(obj, dict) else obj
    if not isinstance(rows, list):
        raise CouldNotRun("trigger json has no `data` list")
    out = []
    for t in rows:
        if not isinstance(t, dict):
            continue
        ds = t.get("derived_state") or {}
        out.append((t.get("id"), t.get("name"), ds.get("prompt")))
    return out


def cmd_prompt_integrity(ctx, args):
    """Compare each stored prompt with the `prompts` row that describes it.

    THREE OUTCOMES, KEPT APART, and that separation is the point of the command.
    A `mismatch` says a prompt changed outside the batch process, which is the
    most serious thing this project's weekly audit can report. A `row_malformed`
    says the RECORD is wrong -- a digest that is truncated, invented or left at
    the previous revision -- which looks identical to a mismatch if the two are
    collapsed, and points at the opposite conclusion. Reporting the second as
    the first manufactures evidence of tampering out of a typing slip.

    WHAT THIS CANNOT CATCH, and it is the reason --emit-rows exists. A digest
    that is well formed but wrong -- invented at full length, or left at the
    previous revision -- is indistinguishable from a prompt that really did
    change outside the batch process. Both are "the row says X, the prompt
    hashes to Y", and nothing here can tell which side is lying. Detection
    therefore closes only half the hole; the other half closes by DERIVING the
    value with --emit-rows at the moment the row is written, so that no digest
    is ever typed by a hand that can slip. Both defects this command was built
    after were typed: one truncated to 16 characters, one invented past 16.
    """
    payload = ctx.read_json(args.trigger_json, "trigger json")
    triggers = load_trigger_prompts(payload)
    rows = dict(read_collection(ctx, args.dir, args.collection)) if args.dir else {}

    results, buckets, emit = [], {}, {}
    for tid, name, prompt in triggers:
        if prompt is None:
            continue
        if args.only and tid not in args.only:
            continue
        body = prompt.encode("utf-8")
        live_bytes, live_sha = len(body), sha256_hex(body)
        emit[tid] = {"bytes": live_bytes, "sha256": live_sha}
        entry = {"id": tid, "name": name, "live_bytes": live_bytes, "live_sha256": live_sha,
                 "row_bytes": None, "row_sha256": None, "verdict": None, "detail": None}

        row = rows.get(tid)
        if not args.dir:
            entry["verdict"] = "not_compared"
            entry["detail"] = "no --dir given; live values measured only"
        elif row is None:
            entry["verdict"] = "row_missing"
            entry["detail"] = "no prompts row for this trigger"
        else:
            rb, rh = row.get("bytes"), row.get("sha256")
            entry["row_bytes"], entry["row_sha256"] = rb, rh
            bad = []
            if not isinstance(rb, int):
                bad.append("bytes is not an integer")
            if not isinstance(rh, str) or not SHA256_RE.match(rh):
                bad.append("sha256 is not 64 lowercase hex")
            if bad:
                entry["verdict"] = "row_malformed"
                entry["detail"] = "; ".join(bad)
            elif rh == live_sha and rb == live_bytes:
                entry["verdict"] = "match"
            elif rh == live_sha:
                # The digest is the authority; a byte count that disagrees with
                # a matching digest is a miscounted record, not a changed prompt
                # (characters counted as bytes is the way this has gone wrong).
                entry["verdict"] = "row_malformed"
                entry["detail"] = "sha256 matches but bytes disagree: row %r, live %d" % (rb, live_bytes)
            else:
                entry["verdict"] = "mismatch"
                entry["detail"] = "stored prompt does not match the row's digest"
        buckets.setdefault(entry["verdict"], []).append(tid)
        results.append(entry)

    out = {"collection": args.collection, "triggers_with_prompts": len(results),
           "results": results,
           "match": buckets.get("match", []), "mismatch": buckets.get("mismatch", []),
           "row_malformed": buckets.get("row_malformed", []),
           "row_missing": buckets.get("row_missing", []),
           "not_compared": buckets.get("not_compared", [])}
    if args.emit_rows:
        # What the row SHOULD say, so a sitting writes a derived value instead
        # of typing one. The reason this exists is that the field an automated
        # check reads had been hand-typed and was wrong three times in four days.
        out["emit_rows"] = emit
    return out


# ---------------------------------------------------------------------------
# all -- several checks in one process

# Order is the daily run's reading order, so the output reads the way the run
# works. A part is RUN, SKIPPED (an input it needs was not supplied) or
# COULD_NOT_RUN (it was tried and failed). The three are different facts and
# the caller is given all three; standing rule 4 says a check that could not
# run is never reported as clean, and a check nobody asked for is not a check
# that failed.
ALL_PARTS = ("surface", "witness", "hashes", "seal", "homepage", "bindings",
             "model", "front", "window")

# cmd_bindings runs against /api/record, measured at 40-47 s on 2026-09-17.
# Its subparser raises the default timeout on its own; sharing one Ctx here
# would silently hand it the 30 s default and make it never run.
ALL_PART_TIMEOUT = {"bindings": 120.0}


class _Skip(Exception):
    """A part was not asked for. Not a failure."""


def _part_args(args, **extra):
    """A namespace carrying the common flags plus one part's own."""
    ns = argparse.Namespace()
    for name in ("offline_dir", "now", "workdir", "timeout"):
        setattr(ns, name, getattr(args, name, None))
    for name, value in extra.items():
        setattr(ns, name, value)
    return ns


def _prior_path(args, stem):
    """<prior-dir>/<ledger state row id>.json, if it is there."""
    if not args.prior_dir:
        return None
    path = os.path.join(args.prior_dir, stem + ".json")
    return path if os.path.exists(path) else None


def _all_entries(args):
    """[(display name, command, builder)] in reading order.

    `seal` expands to one entry per --seal-label, so a failure names the label
    that failed rather than reporting that sealing, in general, did not work.
    """
    def surface():
        return _part_args(args, prior=_prior_path(args, "route-surface"),
                          emit_baseline=args.emit_baseline)

    def witness():
        if not args.witness_url:
            raise _Skip("no --witness-url")
        return _part_args(args, prior=_prior_path(args, "witness-pair"),
                          url=args.witness_url)

    def hashes():
        if not args.url:
            raise _Skip("no --url NAME=URL given")
        return _part_args(args, url=args.url, expect=args.expect,
                          cache_bust=args.cache_bust)

    def homepage():
        return _part_args(args, live=HOMEPAGE_LIVE, repo_raw=HOMEPAGE_REPO,
                          label="homepage", citizen=args.citizen)

    def bindings():
        return _part_args(args, citizen=args.citizen,
                          expect_thumbprint=args.expect_thumbprint)

    def model():
        if not args.configured or not args.record:
            raise _Skip("needs --configured and --record")
        return _part_args(args, configured=args.configured, record=args.record,
                          me=args.me)

    def front():
        return _part_args(args, prior=_prior_path(args, "front-map"),
                          read_ids=args.read_ids)

    def window():
        if not (args.trigger_json and args.name_prefix and args.runs_row):
            raise _Skip("needs --trigger-json, --name-prefix and --runs-row")
        return _part_args(args, trigger_json=args.trigger_json,
                          name_prefix=args.name_prefix, runs_row=args.runs_row,
                          lifetime_dark_seconds=args.lifetime_dark_seconds)

    def seal_missing():
        raise _Skip("no --seal-label")

    def seal_for(label):
        def build():
            return _part_args(args, label=label, citizen=args.citizen,
                              preimage=None)
        return build

    entries = [("surface", "surface", surface), ("witness", "witness", witness),
               ("hashes", "hashes", hashes)]
    if args.seal_label:
        for label in args.seal_label:
            entries.append(("seal:" + label, "seal", seal_for(label)))
    else:
        entries.append(("seal", "seal", seal_missing))
    entries += [("homepage", "homepage", homepage), ("bindings", "bindings", bindings),
                ("model", "model", model), ("front", "front", front),
                ("window", "window", window)]
    return entries


def cmd_all(ctx, args):
    """Run several unauthenticated checks in one process and emit one object.

    Every part is the SAME function the standalone subcommand calls. Nothing is
    reimplemented here: this collapses round trips, and a second copy of any
    recipe would be the defect this file exists to remove.
    """
    skip = set(args.skip or ())
    unknown = sorted(skip - set(ALL_PARTS))
    if unknown:
        raise UsageError("--skip names no such part: %s" % ", ".join(unknown))

    parts = {}
    ran, failed, skipped = [], [], {}
    base_timeout = ctx.timeout

    for display, command, build in _all_entries(args):
        base_name = display.split(":", 1)[0]
        if base_name in skip:
            skipped[display] = "--skip"
            continue
        try:
            part_args = build()
        except _Skip as e:
            skipped[display] = str(e)
            continue
        ctx.timeout = ALL_PART_TIMEOUT.get(base_name, base_timeout)
        try:
            result = COMMANDS[command](ctx, part_args)
            result.update(status="ok", reason=None)
            parts[display] = result
            ran.append(display)
        except CouldNotRun as e:
            parts[display] = {"status": "could_not_run", "reason": str(e)}
            failed.append(display)
        except (KeyError, TypeError, ValueError, AttributeError) as e:
            parts[display] = {"status": "could_not_run",
                              "reason": "unexpected input shape: %s: %s" % (type(e).__name__, e)}
            failed.append(display)
        finally:
            ctx.timeout = base_timeout

    out = {"parts": parts, "parts_ran": ran, "parts_could_not_run": failed,
           "parts_skipped": skipped}
    if failed:
        # Louder than a field nobody reads: the top-level status stops saying ok
        # the moment any part is down, so a caller that reads only `status`
        # cannot report a degraded preflight as a clean one.
        out["status_override"] = "degraded"
        out["reason_override"] = "%d of %d part(s) could not run: %s" % (
            len(failed), len(ran) + len(failed), ", ".join(failed))
    return out



