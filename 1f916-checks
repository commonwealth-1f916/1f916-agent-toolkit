# tally, queue-age -- read_db out_dir files

def read_collection(ctx, directory, collection):
    d = os.path.join(directory, collection)
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json"))
    except OSError as e:
        raise CouldNotRun("collection directory unreadable: %s (%s)" % (d, e.strerror))
    rows = []
    for n in names:
        row = ctx.read_row(os.path.join(d, n), role=collection)
        rows.append((n[:-5], row))
    return rows


def cmd_tally(ctx, args):
    since = None
    if args.since:
        since = parse_iso(args.since)
        if since is None:
            raise UsageError("--since is not ISO 8601: %r" % args.since)
    rows = read_collection(ctx, args.dir, args.collection)
    total, nonzero, missing, undated, considered = 0, [], [], [], 0
    for rid, row in rows:
        if since is not None:
            when = parse_date_loose(row.get(args.date_field))
            if when is None:
                undated.append(rid)
                continue
            if when[0] < since:
                continue
        considered += 1
        v = row.get(args.field)
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            missing.append(rid)
            continue
        total += v
        if v:
            nonzero.append(rid)
    return {"collection": args.collection, "field": args.field,
            "since": iso(since) if since else None, "rows_read": len(rows),
            "rows": considered, "sum": total, "rows_nonzero": len(nonzero), "nonzero_ids": nonzero,
            "rows_missing_field": len(missing), "missing_ids": missing,
            "rows_undated": len(undated), "undated_ids": undated}


def parse_date_loose(value):
    """(datetime, 'datetime'|'date') or None. The ledger writes values like
    2026-09-14T21:0xZ; when the time is not parseable take the date."""
    dt = parse_iso(value)
    if dt is not None:
        return dt, "datetime"
    if isinstance(value, str):
        m = re.match(r"^(\d{4}-\d{2}-\d{2})", value.strip())
        if m:
            dt = parse_iso(m.group(1))
            if dt is not None:
                return dt, "date"
    return None


def cmd_queue_age(ctx, args):
    rows = read_collection(ctx, args.dir, args.collection)
    open_rows, unparseable = [], []
    for rid, row in rows:
        if row.get("state") != "open" or row.get("tier") != args.tier:
            continue
        parsed = parse_date_loose(row.get("opened"))
        if parsed is None:
            unparseable.append(rid)
            continue
        open_rows.append((parsed[0], rid, row.get("opened"), parsed[1]))
    out = {"collection": args.collection, "tier": args.tier, "rows_read": len(rows),
           "open_rows": len(open_rows) + len(unparseable), "unparseable_ids": unparseable,
           "oldest": None}
    if open_rows:
        open_rows.sort()
        dt, rid, raw, how = open_rows[0]
        out["oldest"] = {"id": rid, "opened": raw, "parsed_as": how,
                         "age_days": round((ctx.now - dt).total_seconds() / 86400.0, 2)}
    return out


# ---------------------------------------------------------------------------
# cost -- token and tool-call counters from a transcript, never its content

COST_USAGE_FIELDS = (
    ("input_tokens", "input"),
    ("output_tokens", "output"),
    ("cache_creation_input_tokens", "cache_creation"),
    ("cache_read_input_tokens", "cache_read"),
)


def _cost_tool_class(name):
    if name == "Bash":
        return "bash"
    if name == "ArtifactData":
        return "artifactdata"
    if isinstance(name, str) and name.startswith("mcp__"):
        return "mcp"
    if name in ("WebFetch", "WebSearch"):
        return "web"
    return "other"


def cmd_cost(ctx, args):
    """Token and tool-call counters read from a transcript, integers only.

    The four counters are not one currency and are never summed into each
    other; a `<synthetic>` model row is kept apart in its own block rather
    than folded into the real usage it did not cost. Nothing here prints,
    greps, tails or copies a line of the file -- only the sums and the fixed
    field names below ever reach the output, by construction: no code path
    below assigns a string pulled from the transcript into the result.
    """
    data = ctx.read_file(args.transcript, "transcript")
    raw_lines = data.split(b"\n")
    if raw_lines and raw_lines[-1] == b"":
        raw_lines = raw_lines[:-1]
    if raw_lines == [b""]:
        raw_lines = []

    tokens = {"input": 0, "output": 0, "cache_creation": 0, "cache_read": 0}
    synthetic = {"input": 0, "output": 0, "cache_creation": 0, "cache_read": 0, "messages": 0}
    tool_calls = {"bash": 0, "artifactdata": 0, "mcp": 0, "web": 0, "other": 0}
    messages = 0
    unparsed = 0

    for raw in raw_lines:
        if not raw.strip():
            continue
        try:
            obj = json.loads(raw.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            unparsed += 1
            continue
        if not isinstance(obj, dict):
            continue
        msg = obj.get("message")
        if not isinstance(msg, dict):
            continue
        if obj.get("type") != "assistant" and msg.get("role") != "assistant":
            continue
        messages += 1
        is_synthetic = msg.get("model") == "<synthetic>"
        bucket = synthetic if is_synthetic else tokens
        if is_synthetic:
            synthetic["messages"] += 1
        usage = msg.get("usage")
        if isinstance(usage, dict):
            for src, dst in COST_USAGE_FIELDS:
                v = usage.get(src)
                if isinstance(v, bool) or not isinstance(v, int):
                    continue
                bucket[dst] += v
        content = msg.get("content")
        if isinstance(content, list):
            for block in content:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    tool_calls[_cost_tool_class(block.get("name"))] += 1

    return {"tokens": tokens, "synthetic": synthetic, "messages": messages,
            "tool_calls": tool_calls, "lines": len(raw_lines), "unparsed_lines": unparsed}


