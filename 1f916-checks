def cmd_hashes(ctx, args):
    urls = []
    names = set()
    for item in args.url:
        name, url = split_pair(item, "--url")
        if name in names:
            raise UsageError("--url name given twice: %s" % name)
        names.add(name)
        urls.append((name, url))
    expect = {}
    for item in args.expect or []:
        name, value = split_pair(item, "--expect")
        if name not in names:
            raise UsageError("--expect names no --url: %s" % name)
        expect[name] = value.strip().lower()
    bust = set(args.cache_bust or [])
    for name in bust:
        if name not in names:
            raise UsageError("--cache-bust names no --url: %s" % name)
    files = {}
    for name, url in urls:
        body = ctx.fetch(url, cache_bust=name in bust)
        digest = sha256_hex(body)
        exp = expect.get(name)
        files[name] = {"url": url, "bytes": len(body), "sha256": digest, "expected": exp,
                       "match": None if exp is None else digest == exp}
    matches = [f["match"] for f in files.values() if f["match"] is not None]
    return {"files": files, "all_match": all(matches) if matches else None}


SEAL_FIELDS = ("id", "hash", "signature", "created_at", "sealed_at")


def fetch_seal(ctx, citizen, label):
    q = urllib.parse.urlencode([("citizen", citizen), ("label", label)])
    payload = ctx.fetch_json(REGISTRY + "/api/seals?" + q)
    if not isinstance(payload, dict):
        raise CouldNotRun("seals payload is not an object")
    latest = payload.get("latest")
    if latest is not None and not isinstance(latest, dict):
        raise CouldNotRun("seals payload `latest` is not an object")
    if latest is not None:
        if latest.get("label") not in (None, label):
            raise CouldNotRun("seals payload latest carries label %r, asked for %r"
                              % (latest.get("label"), label))
        latest = dict((k, latest[k]) for k in SEAL_FIELDS if k in latest)
    return latest, payload.get("count")


def cmd_seal(ctx, args):
    latest, count = fetch_seal(ctx, args.citizen, args.label)
    out = {"citizen": args.citizen, "label": args.label, "latest": latest, "count": count}
    if args.preimage:
        data = ctx.read_file(args.preimage, "preimage")
        out["preimage_bytes"] = len(data)
        out["preimage_sha256"] = sha256_hex(data)
        out["match"] = None if latest is None or "hash" not in latest else \
            out["preimage_sha256"] == latest["hash"]
    return out


def cmd_homepage(ctx, args):
    live = sha256_hex(ctx.fetch(args.live, cache_bust=True))
    repo = sha256_hex(ctx.fetch(args.repo_raw))
    latest, _count = fetch_seal(ctx, args.citizen, args.label)
    seal = (latest or {}).get("hash")
    return {
        "live": live, "repo": repo, "seal": seal,
        "seal_signature": (latest or {}).get("signature"),
        "seal_id": (latest or {}).get("id"),
        "agree": live == repo == seal,
        "live_eq_repo": live == repo,
        "repo_eq_seal": repo == seal,
    }


