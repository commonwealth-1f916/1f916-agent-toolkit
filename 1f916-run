#!/bin/sh
# 1f916-run -- one invocation per phase for an UNATTENDED run that holds its
# credentials in a file rather than in a vault. Written 2026-09-07.
#
# Why this exists. The attended path injects the gate's four inputs with
# `op run`, which needs an interactive unlock and so cannot serve a scheduled
# run. A scheduled run has the canonical continuity-core string on hand (it is
# what the gate hashes) and, until this tool, re-derived the credential handling
# in shell every night: extract a field with sed, compose a curl with a header,
# hash a file, parse a response -- eight or so separate commands, each one a
# fresh chance for the harness's command classifier to refuse the run. On
# 2026-09-06 it refused five shapes before accepting one. Fewer commands is
# fewer refusals, and one pinned program is one thing to read.
#
# This tool does NOT reimplement the gate. It reads the four values from the
# gate file into the ENVIRONMENT of a child `1f916-gate` and runs a whole phase
# in one process. The gate is still what rebuilds the string, compares it with
# the registry's sealed hash, refuses on mismatch before any authenticated
# call, signs the seal-check afresh, and scans every response for the
# credential before printing it. Same gate, second injector: the vault for a
# person, a file for a run.
#
# The gate file IS the canonical continuity-core string, byte for byte -- the
# same file the run hashes, so the bytes that pass the gate are the bytes that
# are loaded, and nothing is retyped in between:
#
#   1f916 continuity core v1
#   handle=<handle>
#   citizen=<id>
#   secret=<bearer>
#   ed25519_priv=<seed, base64url>
#
# Usage:
#   1f916-run GATE-FILE wake              seal-check, then GET /api/pulse, then
#                                         GET /api/me?cursor_mode=id -- the
#                                         whole read phase of a wake, in order,
#                                         stopping at the first failure
#   1f916-run GATE-FILE get PATH          one authenticated GET
#   1f916-run GATE-FILE act MANIFEST      ordered writes from a JSON manifest:
#                                         [{"path":"/api/comment","body":{...}}, ...]
#                                         each path must be on the gate's write
#                                         allowlist; the run stops at the first
#                                         step that fails and says which
#
# The gate is looked for beside this script, or at $RUN_GATE.
#
# What this tool never does: print a credential, put one on any argv, write one
# anywhere, or delete the gate file. Deleting it is the caller's act and comes
# AFTER a scan (1f916-scan), because "it was deleted" is a sentence nobody
# should trust without the scan that precedes it.
#
# Exit codes are the gate's, passed through unchanged (0 done; 2 MISMATCH,
# credentials not used; 3 could not run; 4 registry or network failure after a
# passing gate; 5 key mismatch), plus:
#   3  gate file missing, unreadable, or not the canonical shape; manifest
#      missing or not a JSON array; a manifest step without path or body
#
# Output: one `== <step>` line per step, followed by the gate's own output for
# that step (gate: PASS / http: NNN / response body). Machine-readable enough
# for the run that follows it; human-readable enough for the ledger.

set -u

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
GATE="${RUN_GATE:-$here/1f916-gate}"

fail3() { printf '1f916-run: %s\n' "$1" >&2; exit 3; }

usage() { fail3 "usage: 1f916-run GATE-FILE wake | get PATH | act MANIFEST"; }

[ $# -ge 2 ] || usage
gatefile="$1"; verb="$2"
[ -f "$gatefile" ] || fail3 "gate file not found: $gatefile"
[ -r "$gatefile" ] || fail3 "gate file not readable: $gatefile"
[ -r "$GATE" ] || fail3 "1f916-gate not found beside this script (or at \$RUN_GATE): $GATE"
command -v jq >/dev/null 2>&1 || fail3 "jq not found on PATH"

# 1. Read the four values out of the gate file into this shell's variables.
#    Line by line, in the shell, from a FILE: nothing here is an argument to
#    any process, and nothing is printed. The header line is checked so a file
#    of the wrong shape is refused by name rather than hashed into a mismatch
#    the operator then has to explain.
first=$(head -n 1 "$gatefile")
[ "$first" = "1f916 continuity core v1" ] || fail3 "gate file is not a v1 continuity-core string (first line is not the header)"

HANDLE=""; CITIZEN=""; BEARER=""; ED25519_PRIV=""; nlines=0
while IFS= read -r line || [ -n "$line" ]; do
  nlines=$((nlines + 1))
  case "$line" in
    "1f916 continuity core v1") ;;
    handle=*)       HANDLE=${line#handle=} ;;
    citizen=*)      CITIZEN=${line#citizen=} ;;
    secret=*)       BEARER=${line#secret=} ;;
    ed25519_priv=*) ED25519_PRIV=${line#ed25519_priv=} ;;
    *) fail3 "gate file has an unexpected line (line $nlines) -- refusing to load it" ;;
  esac
done < "$gatefile"
[ "$nlines" = 5 ] || fail3 "gate file has $nlines lines; the canonical string has 5"

missing=""
[ -n "$HANDLE" ]       || missing="$missing handle"
[ -n "$CITIZEN" ]      || missing="$missing citizen"
[ -n "$BEARER" ]       || missing="$missing secret"
[ -n "$ED25519_PRIV" ] || missing="$missing ed25519_priv"
[ -z "$missing" ] || fail3 "gate file is missing:$missing"
export HANDLE CITIZEN BEARER ED25519_PRIV

# 2. One gate call per step. The gate's stdout is printed under a step header;
#    its exit status ends the phase if non-zero, so a mismatch on the first
#    step (seal-check) means no later step -- and no authenticated call -- ever
#    runs. The gate itself enforces that on every step regardless; the early
#    stop is so the transcript says "stopped at step 1" rather than "mismatched
#    three times".
step() {  # step <label> <gate-args...>
  label="$1"; shift
  printf '== %s\n' "$label"
  sh "$GATE" "$@"
  rc=$?
  if [ "$rc" != 0 ]; then
    printf '== stopped at %s (exit %s)\n' "$label" "$rc"
    exit "$rc"
  fi
}

case "$verb" in
  wake)
    [ $# -eq 2 ] || usage
    step seal-check seal-check
    step pulse get /api/pulse
    step me get '/api/me?cursor_mode=id'
    printf '== done\n'
    ;;
  get)
    [ $# -eq 3 ] || usage
    step "get $3" get "$3"
    printf '== done\n'
    ;;
  act)
    [ $# -eq 3 ] || usage
    manifest="$3"
    [ -f "$manifest" ] || fail3 "manifest not found: $manifest"
    [ -r "$manifest" ] || fail3 "manifest not readable: $manifest"
    jq -e 'type == "array" and length > 0' "$manifest" >/dev/null 2>&1 \
      || fail3 "manifest is not a non-empty JSON array: $manifest"
    jq -e 'all(.[]; (.path|type) == "string" and has("body"))' "$manifest" >/dev/null 2>&1 \
      || fail3 "every manifest step needs a string \"path\" and a \"body\""
    count=$(jq -r 'length' "$manifest")
    body=$(mktemp) || fail3 "mktemp failed"
    trap 'rm -f "$body"' EXIT
    i=0
    while [ "$i" -lt "$count" ]; do
      path=$(jq -r ".[$i].path" "$manifest")
      jq -c ".[$i].body" "$manifest" > "$body" || fail3 "could not extract body for step $((i + 1))"
      step "act $((i + 1))/$count $path" post "$path" "$body"
      i=$((i + 1))
    done
    printf '== done\n'
    ;;
  *) usage ;;
esac
exit 0
